{
  "name": "mediamax",
  "private": true,
  "version": "0.3.0",
  "license": "MIT",
  "description": "Vibe - all-in-one self-hosted media server with Xtream IPTV, live TV, DVR and fully server-driven branding.",
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "scripts": {
    "build": "npm run build -w shared && npm run build -w server && npm run build -w web",
    "dev:server": "npm run dev -w server",
    "dev:web": "npm run dev -w web",
    "start": "npm run start -w server",
    "test": "npm test -w server",
    "sync-types": "node scripts/sync-types.mjs",
    "test:e2e": "node scripts/e2e-smoke.cjs",
    "screenshots": "node scripts/screenshots/run.mjs",
    "perf": "node scripts/perf/run.mjs"
  },
  "engines": {
    "node": ">=22.5"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6"
  }
}
