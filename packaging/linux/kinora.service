# Vibe systemd unit. Install guide: README.txt in this archive, or docs/INSTALL.md.
#
#   sudo useradd --system --home-dir /var/lib/kinora --shell /usr/sbin/nologin kinora
#   sudo cp kinora.service /etc/systemd/system/ && sudo systemctl daemon-reload
#   sudo systemctl enable --now kinora
#
# Change settings with `sudo systemctl edit kinora` (a drop-in override) rather than editing this file,
# so upgrades can replace it.
[Unit]
Description=Vibe media server
Documentation=https://github.com/Bucifer6/MediaMax/blob/main/docs/INSTALL.md
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=kinora
Group=kinora
# Hardware transcoding (Intel/AMD /dev/dri) needs the render/video groups:
#   sudo usermod -aG render,video kinora
# Media on NAS shares: give the kinora user read access (or add it to the group that owns the files).

# Creates /var/lib/kinora owned by the service user; Vibe keeps its database, caches and logs there
# (systemd passes it as STATE_DIRECTORY). Settings use KINORA_* names; the original MEDIAMAX_* names still work.
StateDirectory=kinora
StateDirectoryMode=0750
Environment=KINORA_PORT=8484
# Environment=KINORA_TRANSCODE_DIR=/dev/shm/kinora
# Environment=KINORA_HWACCEL=vaapi
WorkingDirectory=/var/lib/kinora
ExecStart=/opt/kinora/kinora
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

# Hardening that leaves media and recordings folders readable/writable as normal file permissions allow.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
