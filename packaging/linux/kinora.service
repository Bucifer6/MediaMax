# MediaMax systemd unit. Install guide: README.txt in this archive, or docs/INSTALL.md.
#
#   sudo useradd --system --home-dir /var/lib/mediamax --shell /usr/sbin/nologin mediamax
#   sudo cp mediamax.service /etc/systemd/system/ && sudo systemctl daemon-reload
#   sudo systemctl enable --now mediamax
#
# Change settings with `sudo systemctl edit mediamax` (a drop-in override) rather than editing this file,
# so upgrades can replace it.
[Unit]
Description=MediaMax media server
Documentation=https://github.com/Bucifer6/MediaMax/blob/main/docs/INSTALL.md
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=mediamax
Group=mediamax
# Hardware transcoding (Intel/AMD /dev/dri) needs the render/video groups:
#   sudo usermod -aG render,video mediamax
# Media on NAS shares: give the mediamax user read access (or add it to the group that owns the files).

# Creates /var/lib/mediamax owned by the service user; MediaMax keeps its database, caches and logs there.
StateDirectory=mediamax
StateDirectoryMode=0750
Environment=MEDIAMAX_DATA=/var/lib/mediamax
Environment=MEDIAMAX_PORT=8484
# Environment=MEDIAMAX_TRANSCODE_DIR=/dev/shm/mediamax
# Environment=MEDIAMAX_HWACCEL=vaapi
WorkingDirectory=/var/lib/mediamax
ExecStart=/opt/mediamax/mediamax
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

# Hardening that leaves media and recordings folders readable/writable as normal file permissions allow.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
