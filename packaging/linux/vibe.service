# Vibe systemd unit. Install guide: README.txt in this archive, or docs/INSTALL.md.
#
#   sudo useradd --system --home-dir /var/lib/vibe --shell /usr/sbin/nologin vibe
#   sudo cp vibe.service /etc/systemd/system/ && sudo systemctl daemon-reload
#   sudo systemctl enable --now vibe
#
# Change settings with `sudo systemctl edit vibe` (a drop-in override) rather than editing this file,
# so upgrades can replace it.
[Unit]
Description=Vibe media server
Documentation=https://github.com/Bucifer6/MediaMax/blob/main/docs/INSTALL.md
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=vibe
Group=vibe
# Hardware transcoding (Intel/AMD /dev/dri) needs the render/video groups:
#   sudo usermod -aG render,video vibe
# Media on NAS shares: give the vibe user read access (or add it to the group that owns the files).

# Creates /var/lib/vibe owned by the service user; Vibe keeps its database, caches and logs there
# (systemd passes it as STATE_DIRECTORY). Settings use VIBE_* names; the former KINORA_* and MEDIAMAX_* names still work.
# Moving from the kinora.service of earlier releases: see README.txt ("Upgrading from kinora.service").
StateDirectory=vibe
StateDirectoryMode=0750
Environment=VIBE_PORT=8484
# Environment=VIBE_TRANSCODE_DIR=/dev/shm/vibe
# Environment=VIBE_HWACCEL=vaapi
WorkingDirectory=/var/lib/vibe
ExecStart=/opt/vibe/vibe
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

# Hardening that leaves media and recordings folders readable/writable as normal file permissions allow.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
