# Kinora behind Caddy
#
# One file for both setups, chosen by MEDIAMAX_SITE_ADDRESS in .env (deploy/install.sh writes it):
#   MEDIAMAX_SITE_ADDRESS=media.example.com   automatic HTTPS (Let's Encrypt / ZeroSSL), HTTP→HTTPS redirect, HTTP/3
#   MEDIAMAX_SITE_ADDRESS=:8484               plain http://<server-ip>:8484 when you have no domain
# Add more names with commas: "media.example.com, www.media.example.com".
#
# Optional pieces are dropped into /etc/caddy/conf.d/ by the installer (a glob that matches nothing is fine):
#   *.global  inside the global options below (ACME e-mail, CrowdSec bouncer settings, trusted proxies)
#   *.site    inside the site block (the CrowdSec bouncer handler)
#
# Validate after editing:  docker compose exec caddy caddy validate --config /etc/caddy/Caddyfile
# Reload without downtime: docker compose exec caddy caddy reload --config /etc/caddy/Caddyfile
{
	import /etc/caddy/conf.d/*.global

	# Cloudflare (orange cloud) or another CDN/proxy in front of Caddy?
	# Then the client address arrives in a header, and Caddy must only believe it from that proxy.
	# Uncomment, and keep the ranges current (https://www.cloudflare.com/ips/):
	# servers {
	# 	trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	# 	trusted_proxies_strict
	# 	client_ip_headers CF-Connecting-IP X-Forwarded-For
	# }
	# Note: banning at the firewall does nothing when traffic arrives through Cloudflare (the TCP peer is
	# Cloudflare). The CrowdSec bouncer inside Caddy (below) still works, because it uses the client IP.
}

(mediamax_headers) {
	# Kinora already sends X-Content-Type-Options, Referrer-Policy and X-Frame-Options, and its own
	# Content-Security-Policy on the sandboxed plugin pages and uploaded images (server/src/app.ts,
	# server/src/routes/plugins.ts). "?" only sets a header the server did not send, so nothing here
	# overrides or doubles those policies.
	header {
		?X-Content-Type-Options "nosniff"
		?Referrer-Policy "same-origin"
		?X-Frame-Options "SAMEORIGIN"
		# Only frame-ancestors: a full CSP would have to know every script, image and trailer source the
		# web app uses. Pages that already carry a CSP (the plugin UI sandbox) keep theirs untouched.
		?Content-Security-Policy "frame-ancestors 'self'"
		-Server
		-X-Powered-By
	}
	@mm_https protocol https
	# One year. Add "; includeSubDomains; preload" only once every subdomain is on HTTPS for good.
	header @mm_https Strict-Transport-Security "max-age=31536000"
}

{$MEDIAMAX_SITE_ADDRESS::8484} {
	import /etc/caddy/conf.d/*.site
	import mediamax_headers

	# Uploads: 50 MB in Kinora, with headroom for multipart overhead. Backup restores can be large.
	@mm_restore path /api/v1/admin/backups/restore-upload
	@mm_regular not path /api/v1/admin/backups/restore-upload
	request_body @mm_restore {
		max_size 4GB
	}
	request_body @mm_regular {
		max_size 64MB
	}

	# Compress text only, by response type. Video, audio, HLS playlists (application/vnd.apple.mpegurl)
	# and segments (video/mp2t, video/mp4), live TV MPEG-TS and Range responses are never compressed.
	encode {
		zstd
		gzip 5
		minimum_length 1024
		match {
			header Content-Type text/html*
			header Content-Type text/css*
			header Content-Type text/plain*
			header Content-Type text/javascript*
			header Content-Type application/javascript*
			header Content-Type application/json*
			header Content-Type application/xml*
			header Content-Type text/xml*
			header Content-Type application/manifest+json*
			header Content-Type image/svg+xml*
		}
	}

	reverse_proxy {$MEDIAMAX_UPSTREAM:mediamax:8484} {
		# Send bytes as soon as they arrive: HLS segments, direct streams and live TV MPEG-TS.
		flush_interval -1
		# WebSockets (/api/v1/ws) are proxied automatically; keep them open across `caddy reload`.
		stream_close_delay 5m
		# Ride out a Kinora restart (upgrade, Admin → Restart) instead of failing at once.
		lb_try_duration 30s
		lb_try_interval 1s
		# Caddy sets X-Forwarded-For/-Proto/-Host itself; Kinora trusts them from the Docker network only
		# (MEDIAMAX_TRUSTED_PROXIES in docker-compose.yml).
	}

	# JSON access log, read by CrowdSec (type: caddy). Tokens, API keys (api_key, OpenSubsonic apiKey), device-link
	# poll tokens and Subsonic credentials in query strings are redacted; Authorization and Cookie headers are
	# redacted by Caddy by default, Kinora's own X-Api-Key / X-Kinora-Token (and legacy X-MediaMax-Token) headers are dropped here.
	log {
		output file /var/log/caddy/access.log {
			roll_size 50MiB
			roll_keep 5
		}
		format filter {
			request>uri query {
				replace token REDACTED
				replace api_key REDACTED
				replace apiKey REDACTED
				replace pollToken REDACTED
				replace p REDACTED
				replace t REDACTED
				replace s REDACTED
			}
			request>headers>X-Api-Key delete
			request>headers>X-Kinora-Token delete
			request>headers>X-Mediamax-Token delete
			wrap json
		}
	}
}
