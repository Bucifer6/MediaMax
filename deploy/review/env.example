# Kinora review server settings. Copy to .env (next to docker-compose.yml) and fill in.
# Never commit the filled-in file. Generate passwords with:  openssl rand -base64 18

# Public name of the review server (a DNS A/AAAA record pointing at this host).
REVIEW_HOST=kinora-review.example.com
REVIEW_PUBLIC_URL=https://kinora-review.example.com

# Admin account (for you; never give it to a reviewer).
REVIEW_ADMIN_USERNAME=review-admin
REVIEW_ADMIN_PASSWORD=change-me-admin-password

# The account App Review / Play / Amazon / Samsung / LG / Roku testers sign in with. Paste these in the review notes.
REVIEW_USERNAME=appreview
REVIEW_PASSWORD=change-me-reviewer-password

REVIEW_SERVER_NAME=Kinora Demo
# 1 = add the two generated Live TV test channels (test card, ambient loop) and their guide; 0 = no Live TV.
REVIEW_LIVETV=1
# Put the reviewer account, libraries and guide back every N hours (0 = only at start).
REVIEW_RESET_HOURS=6

# Loopback port your own Caddy proxies to (the stack never listens publicly unless you use --profile https).
KINORA_REVIEW_PORT=8495
KINORA_IMAGE=ghcr.io/bucifer6/kinora:latest
TZ=UTC
