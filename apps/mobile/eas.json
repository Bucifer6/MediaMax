{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "22.12.0",
      "env": {}
    },
    "development": {
      "extends": "base",
      "developmentClient": false,
      "distribution": "internal"
    },
    "ios": {
      "extends": "base",
      "platform": "ios",
      "autoIncrement": true,
      "ios": {
        "resourceClass": "m-medium"
      }
    },
    "ios-simulator": {
      "extends": "base",
      "platform": "ios",
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "android": {
      "extends": "base",
      "platform": "android",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      }
    },
    "android-apk": {
      "extends": "base",
      "platform": "android",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "tvos": {
      "extends": "base",
      "platform": "ios",
      "autoIncrement": true,
      "env": {
        "EXPO_TV": "1"
      },
      "ios": {
        "resourceClass": "m-medium"
      }
    },
    "tvos-simulator": {
      "extends": "tvos",
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "androidtv": {
      "extends": "base",
      "platform": "android",
      "autoIncrement": true,
      "env": {
        "EXPO_TV": "1"
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "androidtv-apk": {
      "extends": "androidtv",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "firetv": {
      "extends": "androidtv",
      "distribution": "store",
      "env": {
        "EXPO_TV": "1",
        "EXPO_FIRETV": "1"
      },
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "ios": {},
    "android": {},
    "tvos": {},
    "androidtv": {}
  }
}
