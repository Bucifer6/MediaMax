{
  "name": "mediamax-mobile",
  "version": "0.1.0",
  "license": "MIT",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.26",
    "expo-application": "~58.1.2",
    "expo-audio": "~58.0.12",
    "expo-blur": "~58.0.6",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.12",
    "expo-image": "~58.0.18",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-video": "~58.0.14",
    "expo-web-browser": "~58.0.8",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-google-cast": "^4.9.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1"
  },
  "devDependencies": {
    "@react-native-tvos/config-tv": "^0.1.7",
    "@types/node": "^22.20.5",
    "@types/react": "~19.3.0",
    "react-dom": "19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "sync-types": "cd ../.. && node scripts/sync-types.mjs",
    "prebuild": "expo prebuild --clean",
    "prebuild:tv": "EXPO_TV=1 expo prebuild --clean",
    "ios:tv": "EXPO_TV=1 expo run:ios",
    "android:tv": "EXPO_TV=1 expo run:android",
    "start:tv": "EXPO_TV=1 expo start",
    "brand": "node scripts/brand.mjs",
    "tv:on": "node scripts/tv-deps.mjs on --install",
    "tv:off": "node scripts/tv-deps.mjs off --install",
    "eas-build-pre-install": "node scripts/tv-deps.mjs auto"
  },
  "private": true,
  "mediamax": {
    "reactNativeStock": "0.88.1",
    "reactNativeTvos": "0.88.1-0"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native"
      ]
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false
      }
    }
  }
}
