<?xml version="1.0" encoding="utf-8"?>
<!-- "Who's watching?": the account's profiles (GET /auth/account/profiles), switch with POST /auth/profiles/:id/switch. -->
<component name="ProfileScreen" extends="BaseScreen">
  <script type="text/brightscript" uri="pkg:/components/common/Utils.brs" />
