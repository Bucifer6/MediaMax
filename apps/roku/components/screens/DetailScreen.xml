<?xml version="1.0" encoding="utf-8"?>
<!--
  Item detail (GET /items/:id). Movies / videos / episodes: resume or play from start, audio and subtitle choice,
  watched and My List toggles. Shows (and seasons, which open their show): next-up button, seasons and episodes.
-->
<component name="DetailScreen" extends="BaseScreen">
  <script type="text/brightscript" uri="pkg:/components/common/Utils.brs" />
  <script type="text/brightscript" uri="pkg:/components/common/Api.brs" />
  <script type="text/brightscript" uri="pkg:/components/common/Screen.brs" />
  <script type="text/brightscript" uri="pkg:/components/common/Content.brs" />
  <script type="text/brightscript" uri="pkg:/components/screens/DetailScreen.brs" />
  <children>
    <Poster id="backdrop" width="1920" height="1080" loadDisplayMode="scaleToZoom" opacity="0.3" />
    <Rectangle width="1920" height="1080" color="0x13183EAA" />

    <!-- Movie / episode layout -->
    <Group id="leafLayout" visible="false">
      <Poster id="poster" translation="[96,120]" width="400" height="600" loadDisplayMode="scaleToZoom" />
      <Label id="title" translation="[560,110]" width="1260" wrap="true" maxLines="2" color="0xFFFFFFFF" font="font:LargeBoldSystemFont" />
      <Label id="subtitle" translation="[560,200]" width="1260" color="0xD5DAF5FF" font="font:MediumSystemFont" />
      <Label id="meta" translation="[560,250]" width="1260" color="0x22D3EEFF" font="font:SmallBoldSystemFont" />
      <Label id="overview" translation="[560,300]" width="1260" wrap="true" maxLines="5" lineSpacing="4" color="0xD5DAF5FF" font="font:SmallSystemFont" />
      <Label id="tech" translation="[560,500]" width="1260" color="0xA9B0D6FF" font="font:SmallestSystemFont" />
      <ButtonGroup id="buttons" translation="[560,560]" minWidth="640" />
      <Label id="people" translation="[96,760]" width="400" wrap="true" maxLines="6" color="0xA9B0D6FF" font="font:SmallestSystemFont" />
    </Group>

    <!-- Show layout -->
    <Group id="showLayout" visible="false">
      <Label id="showTitle" translation="[96,70]" width="1728" color="0xFFFFFFFF" font="font:LargeBoldSystemFont" />
      <Label id="showMeta" translation="[96,140]" width="1728" color="0x22D3EEFF" font="font:SmallBoldSystemFont" />
      <Label id="showOverview" translation="[96,186]" width="1500" wrap="true" maxLines="3" lineSpacing="4" color="0xD5DAF5FF" font="font:SmallSystemFont" />
      <ButtonGroup id="showButtons" translation="[96,320]" minWidth="680" />
      <Label translation="[96,500]" width="380" text="Seasons" color="0xA9B0D6FF" font="font:SmallBoldSystemFont" />
      <LabelList id="seasons" translation="[96,550]" itemSize="[380,64]" numRows="7" vertFocusAnimationStyle="floatingFocus"
        color="0xD5DAF5FF" focusedColor="0x0B0E26FF" focusBitmapBlendColor="0x22D3EEFF" font="font:MediumSystemFont" focusedFont="font:MediumBoldSystemFont" />
      <Label id="episodesTitle" translation="[520,500]" width="1300" color="0xA9B0D6FF" font="font:SmallBoldSystemFont" />
      <MarkupList id="episodes" translation="[520,550]" itemComponentName="EpisodeItem" itemSize="[1304,160]" itemSpacing="[0,12]"
        numRows="3" drawFocusFeedback="false" vertFocusAnimationStyle="floatingFocus" />
    </Group>

    <Label id="error" translation="[96,500]" width="1728" horizAlign="center" wrap="true" color="0xF87171FF" font="font:MediumSystemFont" />
  </children>
</component>
