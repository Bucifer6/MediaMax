<?xml version="1.0" encoding="utf-8"?>
<!-- Live TV list row: logo, number + name, what's on now (with progress) and what's next. -->
<component name="ChannelItem" extends="Group">
  <interface>
    <field id="itemContent" type="node" onChange="onContent" />
    <field id="width" type="float" onChange="onSize" />
    <field id="height" type="float" onChange="onSize" />
    <field id="focusPercent" type="float" onChange="onFocus" />
    <field id="itemHasFocus" type="boolean" onChange="onFocus" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/items/ChannelItem.brs" />
  <children>
    <Rectangle id="bg" color="0x1E2452FF" />
    <Rectangle id="logoBg" translation="[16,12]" width="180" height="100" color="0x0B0E26FF" />
    <Poster id="logo" translation="[26,17]" width="160" height="90" loadDisplayMode="scaleToFit" />
    <Label id="name" translation="[220,14]" width="520" color="0xFFFFFFFF" font="font:MediumBoldSystemFont" />
    <Label id="star" translation="[220,66]" width="200" color="0xFACC15FF" font="font:SmallestBoldSystemFont" text="FAVOURITE" visible="false" />
    <Label id="now" translation="[760,14]" color="0xFFFFFFFF" font="font:SmallBoldSystemFont" />
    <Rectangle id="progressBg" translation="[760,60]" height="6" color="0x3A4280FF" />
    <Rectangle id="progressBar" translation="[760,60]" height="6" color="0x22D3EEFF" />
    <Label id="next" translation="[760,76]" color="0xA9B0D6FF" font="font:SmallestSystemFont" />
  </children>
</component>
