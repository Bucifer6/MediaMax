<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets" id="http://mediamax.tv/tizen" version="0.1.0" viewmodes="maximized">
  <tizen:application id="MdMaxTV001.MediaMax" package="MdMaxTV001" required_version="4.0"/>
  <name>MediaMax</name>
  <description>Your MediaMax server on a Samsung TV.</description>
  <icon src="icon.png"/>
  <content src="index.html"/>
  <feature name="http://tizen.org/feature/screen.size.all"/>
  <tizen:privilege name="http://tizen.org/privilege/internet"/>
  <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
  <!-- The wrapper navigates to the user's own server, so any origin must be allowed. -->
  <access origin="*" subdomains="true"/>
  <tizen:allow-navigation>*</tizen:allow-navigation>
  <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable" encryption="disable" install-location="auto" hwkey-event="enable"/>
  <tizen:profile name="tv-samsung"/>
</widget>
